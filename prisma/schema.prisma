// =====================================================================
// SCHEMA - CBF Almoxarifado (COM MÓDULO DE REQUISIÇÕES POR ITEM)
// =====================================================================
//
// ALTERAÇÕES NESTA REVISÃO (módulo Requisições):
//
// 1. Solicitacao virou um CABEÇALHO de pedido (numero, tipo, origem,
//    prioridade, status AGREGADO calculado a partir dos itens). Os campos
//    materialId/quantidade/aprovador*/preparador* saíram daqui.
//
// 2. Novo model ItemSolicitacao — uma linha por material dentro do pedido,
//    com status, aprovação e preparo PRÓPRIOS. Tem a flag
//    `alteradoManualmente` que trava o item contra ações em massa feitas
//    no cabeçalho (se o almoxarife mexeu manualmente naquele item
//    específico, uma ação "aprovar tudo" no pedido não sobrescreve ele).
//
// 3. Solicitacao agora aceita solicitante de duas formas (nunca as duas):
//      - solicitanteUserId  -> usuário logado
//      - pessoaAtendidaId   -> pessoa cadastrada pelo almoxarife,
//                              selecionada via autocomplete no formulário
//                              público (sem texto livre, pra não duplicar
//                              "João" e "joão" nos relatórios)
//    O campo `origem` (AUTENTICADO | PUBLICO) deixa explícito qual dos
//    dois está preenchido.
//
// 4. MovimentacaoEstoque e Emprestimo agora apontam pro ITEM da
//    requisição (itemSolicitacaoId), não mais pro cabeçalho — já que um
//    pedido pode ter vários materiais, cada um gerando sua própria
//    movimentação/empréstimo quando entregue.
//
// 5. StatusSolicitacao foi reduzido pra ser só o status AGREGADO do
//    cabeçalho (calculado, não editado diretamente). O detalhe real do
//    fluxo (aprovação, preparo, entrega, rejeição) mora no
//    StatusItemSolicitacao, por item.
//
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  ADMIN
  GESTOR
  SUPERVISOR
  ALMOXARIFE
  SOLICITANTE
}

enum UserStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusMaterial {
  ATIVO
  INATIVO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
  DESCARTE
}

enum TipoSolicitacao {
  SAIDA
  EMPRESTIMO
  TRANSFERENCIA
}

// Status AGREGADO do cabeçalho — calculado a partir do status dos itens.
// Nunca é setado manualmente numa ação de item; só recalculado depois de
// cada mudança (ver src/lib/requisicoes-helpers.ts -> calcularStatusAgregado).
enum StatusSolicitacao {
  PENDENTE
  AGUARDANDO_APROVACAO
  EM_ANDAMENTO
  PRONTO
  ENTREGUE
  CANCELADA
}

// Status de cada ITEM dentro da requisição — é aqui que o fluxo de
// verdade acontece.
enum StatusItemSolicitacao {
  PENDENTE
  AGUARDANDO_APROVACAO_SUPERIOR
  APROVADO
  REJEITADO
  EM_PREPARACAO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum OrigemSolicitacao {
  AUTENTICADO
  PUBLICO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoAgendamento {
  RETIRADA
  ENTREGA
  INSTALACAO
}

enum AgendamentoStatus {
  AGENDADO
  CONFIRMADO
  CANCELADO
  REALIZADO
}

enum StatusEmprestimo {
  PENDENTE_APROVACAO
  EMPRESTADO
  DEVOLVIDO
  ATRASADO
  PERDIDO
  REJEITADO
}

enum TipoItemCompra {
  MATERIAL_EXISTENTE
  MATERIAL_NOVO
}

enum StatusItemCompra {
  EM_ESPERA
  ORCANDO
  APROVADO
  AGUARDANDO_ENTREGA
  RECEBIDO
  CANCELADO
}

enum StatusPedidoCompra {
  ABERTO
  PARCIALMENTE_RECEBIDO
  CONCLUIDO
  CANCELADO
}

enum NotificacaoTipo {
  SOLICITACAO_CRIADA
  SOLICITACAO_APROVADA
  SOLICITACAO_REJEITADA
  SOLICITACAO_PREPARANDO
  SOLICITACAO_PRONTA
  SOLICITACAO_ENTREGUE
  SOLICITACAO_CANCELADA
  ITEM_REQUER_APROVACAO_SUPERIOR
  AGENDAMENTO_CONFIRMADO
  EMPRESTIMO_ATRASADO
  PEDIDO_COMPRA_ATUALIZADO
  ALERTA_ESTOQUE_BAIXO
  ALERTA_ESTOQUE_MAXIMO
  ACESSO_APROVADO
  ACESSO_REJEITADO
  NOVO_CADASTRO_PENDENTE
  EMPRESTIMO_PENDENTE_APROVACAO
  EMPRESTIMO_APROVADO
  EMPRESTIMO_REJEITADO
}

enum TipoUnidade {
  INTEIRA
  FRACIONADA
}

// Natureza do material quanto ao retorno ao almoxarifado:
// - CONSUMIVEL: sai pra uso definitivo (lâmpada, tinta, parafuso) — nunca
//   fica "em posse" de ninguém, conta como consumido nos relatórios.
// - RETORNAVEL: ferramenta/equipamento que precisa voltar — ao entregar,
//   gera empréstimo e fica "em posse" da pessoa até a devolução.
enum TipoUsoMaterial {
  CONSUMIVEL
  RETORNAVEL
}

// =====================================================================
// AUTENTICAÇÃO (Supabase Auth — id é o UUID do Supabase, não gerado pelo Prisma)
// =====================================================================

model User {
  id String @id

  name      String
  nome      String
  sobrenome String

  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(SOLICITANTE)

  ativo Boolean @default(false)

  status         UserStatus @default(PENDENTE)
  aprovadoPorId  String?
  aprovadoPor    User?      @relation("UserAprovadoPor", fields: [aprovadoPorId], references: [id])
  dataAprovacao  DateTime?
  motivoRejeicao String?

  usuariosAprovados User[] @relation("UserAprovadoPor")

  setor     String?
  cargo     String?
  telefone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materiaisCadastrados   Material[]             @relation("MaterialCriadoPor")
  movimentacoes          MovimentacaoEstoque[]  @relation("MovimentacaoUsuario")

  solicitacoesCriadas    Solicitacao[]          @relation("SolicitacaoCriadaPor")
  solicitacoesLancadas   Solicitacao[]          @relation("SolicitacaoLancadaPor")

  itensAprovados         ItemSolicitacao[]      @relation("ItemSolicitacaoAprovadoPor")
  itensPreparados        ItemSolicitacao[]      @relation("ItemSolicitacaoPreparadoPor")
  itensEntregues         ItemSolicitacao[]      @relation("ItemSolicitacaoEntreguePor")

  emprestimosResponsavel Emprestimo[]           @relation("EmprestimoResponsavel")
  emprestimosAprovados   Emprestimo[]           @relation("EmprestimoAprovadoPor")
  logsAuditoria          LogAuditoria[]
  pedidosCompraCriados   PedidoCompra[]         @relation("PedidoCompraCriadoPor")
  itensCompraRecebidos   ItemPedidoCompra[]     @relation("ItemPedidoCompraRecebidoPor")
  agendamentos           Agendamento[]          @relation("AgendamentoUsuario")
  notificacoes           Notificacao[]          @relation("NotificacaoUsuario")
  statusHistory          StatusHistory[]

  @@index([role])
  @@index([email])
  @@index([status])
  @@index([ativo])
}

// =====================================================================
// CADASTROS BASE
// =====================================================================

model Categoria {
  id        String   @id @default(cuid())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  materiais     Material[]
  pedidosCompra PedidoCompra[] @relation("PedidoCompraArea")

  @@index([nome])
}

model UnidadeMedida {
  id        String   @id @default(cuid())
  sigla     String   @unique
  nome      String
  tipo      TipoUnidade @default(INTEIRA)
  createdAt DateTime @default(now())

  materiais Material[]

  @@index([sigla])
}

// =====================================================================
// MATERIAIS
// =====================================================================

model Material {
  id String @id @default(cuid())

  numeroSequencial Int    @unique @default(autoincrement())
  codigoInterno    String @unique

  codigoBarras String? @unique
  qrCode       String? @unique

  nome      String
  descricao String?

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  unidadeMedidaId String
  unidadeMedida   UnidadeMedida @relation(fields: [unidadeMedidaId], references: [id])

  marca       String?
  fabricante  String?
  modelo      String?
  numeroSerie String?
  fornecedor  String?

  estoqueMinimo Decimal @default(0) @db.Decimal(12, 3)
  estoqueIdeal  Decimal @default(0) @db.Decimal(12, 3)
  estoqueMaximo Decimal @default(0) @db.Decimal(12, 3)
  estoqueAtual  Decimal @default(0) @db.Decimal(12, 3)

  localizacaoFisica String?
  situacao          StatusMaterial @default(ATIVO)
  fotoUrl           String?
  requerAprovacao   Boolean        @default(false)

  // Define o comportamento padrão na entrega (pode ser ajustado item a
  // item na entrega pelo almoxarife — ver MovimentacaoEstoque.precisaRetorno).
  tipoUso TipoUsoMaterial @default(CONSUMIVEL)

  criadoPorId String
  criadoPor   User   @relation("MaterialCriadoPor", fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimentacoes     MovimentacaoEstoque[]
  itensSolicitacao  ItemSolicitacao[]
  emprestimos       Emprestimo[]
  itensPedidoCompra ItemPedidoCompra[]

  @@index([categoriaId])
  @@index([situacao])
  @@index([nome])
  @@index([codigoInterno])
}

// =====================================================================
// PESSOA ATENDIDA - registro leve de pessoas atendidas pelo almoxarifado
// (fonte única de nome/setor/função pro formulário público — evita
// duplicidade tipo "João" vs "joão" nos relatórios)
// =====================================================================

model PessoaAtendida {
  id      String @id @default(cuid())
  nome    String
  setor   String
  funcao  String

  createdAt DateTime @default(now())

  solicitacoes Solicitacao[]
  movimentacoes MovimentacaoEstoque[]
  emprestimos   Emprestimo[]

  @@index([nome])
  @@index([setor])
}

// =====================================================================
// MOVIMENTAÇÕES DE ESTOQUE
// =====================================================================

model MovimentacaoEstoque {
  id String @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  tipo TipoMovimentacao

  quantidade         Decimal @db.Decimal(12, 3)
  quantidadeAnterior Decimal @db.Decimal(12, 3)
  quantidadeAtual    Decimal @db.Decimal(12, 3)

  motivo              String?
  documentoReferencia String?

  solicitanteNome   String?
  solicitanteSetor  String?
  solicitanteFuncao String?

  // Pessoa do cadastro leve que pediu/recebeu o material. Obrigatória na
  // API para SAÍDA (e preenchida nas saídas de empréstimo/requisição);
  // os solicitante* acima continuam sendo o snapshot imutável copiado
  // dela na criação (listas, relatórios e PDFs leem esses campos).
  // Nullable no banco apenas para preservar registros anteriores à regra.
  pessoaAtendidaId String?
  pessoaAtendida   PessoaAtendida? @relation(fields: [pessoaAtendidaId], references: [id], onDelete: SetNull)

  // Marcado na entrega: esse material precisa voltar pro almoxarifado?
  // null = sem marcação (legado) — nesse caso considera-se retorno apenas
  // quando existe empréstimo vinculado (emprestimoId).
  precisaRetorno Boolean?

  usuarioId String
  usuario   User   @relation("MovimentacaoUsuario", fields: [usuarioId], references: [id])

  // Aponta pro ITEM da requisição (não mais pro cabeçalho) — um pedido
  // pode ter N materiais, cada um com sua própria movimentação.
  itemSolicitacaoId String?          @unique
  itemSolicitacao   ItemSolicitacao? @relation(fields: [itemSolicitacaoId], references: [id])

  emprestimoId String?
  emprestimo   Emprestimo? @relation(fields: [emprestimoId], references: [id])

  movimentacaoOrigemId String?
  movimentacaoOrigem   MovimentacaoEstoque?  @relation("Devolucao", fields: [movimentacaoOrigemId], references: [id])
  devolucoes           MovimentacaoEstoque[] @relation("Devolucao")

  itemPedidoCompraId String?           @unique
  itemPedidoCompra   ItemPedidoCompra? @relation(fields: [itemPedidoCompraId], references: [id])

  createdAt DateTime @default(now())

  @@index([materialId])
  @@index([tipo])
  @@index([createdAt])
  @@index([emprestimoId])
  @@index([pessoaAtendidaId])
}

// =====================================================================
// REQUISIÇÕES (cabeçalho do pedido)
// =====================================================================

model Solicitacao {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  // Aplica-se a TODOS os itens do pedido (um pedido é de um tipo só).
  tipo   TipoSolicitacao
  origem OrigemSolicitacao @default(AUTENTICADO)

  // Exatamente um dos dois preenchido — validado na API, não no schema.
  solicitanteUserId String?
  solicitanteUser   User?   @relation("SolicitacaoCriadaPor", fields: [solicitanteUserId], references: [id])

  pessoaAtendidaId String?
  pessoaAtendida   PessoaAtendida? @relation(fields: [pessoaAtendidaId], references: [id])

  // Preenchido só quando um membro da equipe (ALMOXARIFE+) lança a
  // requisição NO LUGAR de quem pediu (pedido recebido por WhatsApp,
  // e-mail, telefone etc.) — nesse caso pessoaAtendidaId é quem pediu de
  // fato, e lancadoPorId é quem digitou o pedido no sistema. Fica nulo
  // quando a pessoa lança pra si mesma (autenticado) ou usa o formulário
  // público (aí ninguém da equipe "lançou", foi a própria pessoa).
  lancadoPorId String?
  lancadoPor   User?   @relation("SolicitacaoLancadaPor", fields: [lancadoPorId], references: [id])

  // Status AGREGADO — recalculado a cada mudança de item, nunca setado à mão.
  status     StatusSolicitacao @default(PENDENTE)
  prioridade Prioridade        @default(MEDIA)

  motivo               String?
  observacoesInternas  String?
  anexos               Json?

  // Prazo máximo aceitável pra atender o pedido (substituiu o antigo
  // campo "data desejada" — mais direto pro almoxarife priorizar).
  dataLimite DateTime?

  agendamentoId String?      @unique
  agendamento   Agendamento?

  itens ItemSolicitacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tipo])
  @@index([origem])
  @@index([prioridade])
  @@index([solicitanteUserId])
  @@index([pessoaAtendidaId])
  @@index([lancadoPorId])
  @@index([numero])
}

// =====================================================================
// ITEM DA REQUISIÇÃO — uma linha por material, com fluxo próprio
// =====================================================================

model ItemSolicitacao {
  id String @id @default(cuid())

  solicitacaoId String
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  quantidade Decimal @db.Decimal(12, 3)

  status StatusItemSolicitacao @default(PENDENTE)

  // Copiado de Material.requerAprovacao NO MOMENTO da criação do item —
  // preserva o histórico mesmo se o material mudar essa flag depois.
  requerAprovacaoSuperior Boolean @default(false)

  // Trava contra ações em massa feitas no cabeçalho: se true, uma ação
  // "aplicar a todos" no pedido pula esse item.
  alteradoManualmente Boolean @default(false)

  aprovadorId    String?
  aprovador      User?     @relation("ItemSolicitacaoAprovadoPor", fields: [aprovadorId], references: [id])
  dataAprovacao  DateTime?
  motivoRejeicao String?

  preparadorId      String?
  preparador        User?     @relation("ItemSolicitacaoPreparadoPor", fields: [preparadorId], references: [id])
  dataInicioPreparo DateTime?
  dataFimPreparo    DateTime?

  dataEntrega   DateTime?
  entreguePorId String?
  entreguePor   User?     @relation("ItemSolicitacaoEntreguePor", fields: [entreguePorId], references: [id])

  // Só relevante quando solicitacao.tipo == EMPRESTIMO.
  dataPrevistaDevolucao DateTime?

  observacao String?

  movimentacao MovimentacaoEstoque?
  emprestimo   Emprestimo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([solicitacaoId])
  @@index([materialId])
  @@index([status])
}

// =====================================================================
// AGENDAMENTOS
// =====================================================================

model Agendamento {
  id String @id @default(cuid())

  solicitacaoId String      @unique
  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])

  tipoAgendamento TipoAgendamento @default(RETIRADA)

  dataAgendada   DateTime
  dataConfirmada DateTime?
  dataCancelada  DateTime?

  horarioInicio String?
  horarioFim    String?

  localEntrega String?
  observacoes  String?

  status AgendamentoStatus @default(AGENDADO)

  usuarioId String
  usuario   User   @relation("AgendamentoUsuario", fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dataAgendada])
  @@index([status])
}

// =====================================================================
// EMPRÉSTIMOS
// =====================================================================

model Emprestimo {
  id String @id @default(cuid())

  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  quantidade Decimal @db.Decimal(12, 3)

  solicitanteNome   String
  solicitanteSetor  String?
  solicitanteFuncao String?

  // Cadastro leve de quem recebeu — fonte dos solicitante* acima. A API
  // exige pessoaAtendidaId em novos empréstimos e absorve os dados do
  // cadastro; nullable no banco preserva registros anteriores à regra.
  pessoaAtendidaId String?
  pessoaAtendida   PessoaAtendida? @relation(fields: [pessoaAtendidaId], references: [id], onDelete: SetNull)

  loteId String?

  dataRetirada          DateTime  @default(now())
  dataPrevistaDevolucao DateTime
  dataDevolucao         DateTime?

  status      StatusEmprestimo @default(EMPRESTADO)
  observacoes String?

  aprovacaoNecessaria Boolean @default(false)

  aprovadorId    String?
  aprovador      User?     @relation("EmprestimoAprovadoPor", fields: [aprovadorId], references: [id])
  dataAprovacao  DateTime?
  motivoRejeicao String?

  responsavelId String
  responsavel   User   @relation("EmprestimoResponsavel", fields: [responsavelId], references: [id])

  // Aponta pro ITEM da requisição que originou o empréstimo (quando veio
  // do fluxo de Requisições). Pode ser nulo — empréstimo avulso continua
  // possível, criado direto pela rota /api/emprestimos existente.
  itemSolicitacaoId String?          @unique
  itemSolicitacao   ItemSolicitacao? @relation(fields: [itemSolicitacaoId], references: [id])

  movimentacoes MovimentacaoEstoque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([materialId])
  @@index([dataPrevistaDevolucao])
  @@index([loteId])
  @@index([pessoaAtendidaId])
}

// =====================================================================
// IDENTIDADE VISUAL DA ORGANIZAÇÃO
// =====================================================================

// Singleton (id fixo 'principal'): identidade visual configurável pelo ADMIN
// sem deploy. Sobrescreve apenas os tokens de marca do Theme default
// (ver src/styles/visual-identity.ts). Campos nulos = usa fallback default.
model ConfiguracaoVisual {
  id              String  @id @default("principal")

  nomeOrganizacao String?

  corPrimaria        String?
  corAccent          String?
  corDestaque        String?
  corBackground      String?
  corSurface         String?
  corSidebar         String?
  corTextoPrimaria   String?
  corTextoSecundaria String?
  corLink            String?

  logoUrl              String?
  loginBackgroundUrl   String?
  sidebarBackgroundUrl String?

  atualizadoPorId String?
  atualizadoEm    DateTime @updatedAt

  @@map("configuracoes_visuais")
}

// =====================================================================
// PEDIDOS DE COMPRA
// =====================================================================

model PedidoCompra {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  areaId String?
  area   Categoria? @relation("PedidoCompraArea", fields: [areaId], references: [id])

  solicitanteId String
  solicitante   User   @relation("PedidoCompraCriadoPor", fields: [solicitanteId], references: [id])

  solicitanteNome    String
  solicitanteSetor   String
  solicitanteFuncao  String

  status      StatusPedidoCompra @default(ABERTO)
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens ItemPedidoCompra[]

  @@index([status])
  @@index([areaId])
  @@index([solicitanteSetor])
}

model ItemPedidoCompra {
  id String @id @default(cuid())

  pedidoId String
  pedido   PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tipo TipoItemCompra

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id])

  nomeMaterialNovo String?
  descricaoNovo    String?
  unidadeSugerida  String?

  marcaNovo      String?
  fabricanteNovo String?
  modeloNovo     String?
  fornecedorNovo String?

  quantidade         Decimal @db.Decimal(12, 3)
  quantidadeRecebida Decimal @default(0) @db.Decimal(12, 3)

  status StatusItemCompra @default(EM_ESPERA)
  observacao String?

  prazoMaximoNecessario DateTime?

  dataRecebimento DateTime?
  recebidoPorId   String?
  recebidoPor     User?     @relation("ItemPedidoCompraRecebidoPor", fields: [recebidoPorId], references: [id])

  movimentacao MovimentacaoEstoque?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([materialId])
  // FK usada nos JOINs de itens da listagem/exportação de pedidos e em
  // recalcularStatusPedido (findMany por pedidoId).
  @@index([pedidoId])
}

// =====================================================================
// NOTIFICAÇÕES
// =====================================================================

model Notificacao {
  id String @id @default(cuid())

  usuarioId String
  usuario   User @relation("NotificacaoUsuario", fields: [usuarioId], references: [id])

  titulo   String
  mensagem String
  tipo     NotificacaoTipo
  lida     Boolean @default(false)

  entidade   String
  entidadeId String

  dados Json?

  createdAt DateTime  @default(now())
  lidaEm    DateTime?

  @@index([usuarioId])
  @@index([lida])
  @@index([createdAt])
}

// =====================================================================
// HISTÓRICO DE STATUS
// =====================================================================

model StatusHistory {
  id String @id @default(cuid())

  entidade   String // "Solicitacao" | "ItemSolicitacao"
  entidadeId String

  statusAnterior String?
  statusNovo     String
  observacao     String?

  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([createdAt])
}

// =====================================================================
// AUDITORIA
// =====================================================================

model LogAuditoria {
  id String @id @default(cuid())

  usuarioId String?
  usuario   User?   @relation(fields: [usuarioId], references: [id])

  acao       String
  entidade   String
  entidadeId String?

  dadosAnteriores Json?
  dadosNovos      Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([createdAt])
}
